# Xcode
*.xcodeproj/xcuserdata/

# Mootx01-App xcodegen outputs (project.yml is the source of truth)
/apps/Mootx01-App/Mootx01-App.xcodeproj/
/apps/Mootx01-App/derived-Info-*.plist
/apps/Mootx01-App/App/Mootx01-macOS.entitlements
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Archives and sensitive data
*.archive
*.binary
*.db
.obsidian/

# Zip files
*.zip

# Context packs (generated at session start, not committed)
.context/

# Claude Code session state
.claude/active-mission.md
.claude/worktrees/
.context/
./CLAUDE.MD

#Swift / Rust builds
.build/
.swiftpm/

# Rust build artifacts — global, any depth (every crate's target/ dir)
**/target/

# The shared per-checkout Rust target directory (CARGO_TARGET_DIR, set by the
# Makefile and scripts/moot-test). Replaces the 30 per-workspace target/ dirs.
cargo-target/

# Cargo lockfiles are not tracked, any depth
**/Cargo.lock

# Security-audit Finder-flag manifest (local triage sidecar)
packages/.audit-flagged

# Python build artifacts (moot-memory adapter wheel/sdist + metadata) —
# rebuilt from source by `python3 -m build`; never committed.
apps/moot-memory-adapter/dist/
apps/moot-memory-adapter/*.egg-info/
apps/moot-memory-adapter/build/
__pycache__/

# Local-only directories (any depth) — not pushed upstream
_sandbox*/
.claude*/
# …except the plugin's Claude Code marketplace manifest dir: that is shipped
# product content (publish-plugin.sh reads the plugin version from it), not
# local agent config.
!distribution/plugin/.claude-plugin/

# Maintainer dev-bootstrap drop-ins (EE agent system reached via symlink for
# v1.0.x bug-fix work — see ee-edition/tools/ce-dev-setup.sh). Never committed to
# the public repo; a public clone gets none of these.
.claude
docs_internal
CLAUDE.md

# Python test/build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Go test/build artifacts
*.test
coverage.out
coverage.html
.codegraph/

# EE dev-tooling — never ship to CE
.worktreeinclude

# Exception: the moot-agent-skills adapter kit ships literal client config
# files (.claude/, CLAUDE.md) as product content, not local config.
# Re-include them so new adapter files are not silently dropped.
!apps/moot-agent-skills/**/.claude/
!apps/moot-agent-skills/**/.claude/**
!apps/moot-agent-skills/**/CLAUDE.md
# ...but never Python bytecode inside the adapter kit
apps/moot-agent-skills/**/__pycache__/

# Internal work products — never ship in CE (leak remediation 2026-07-20)
docs/findings/
# docs/blast_radius/ is unignored: BRRs must commit normally (they are Adams's
# gate; force-adding them on every mission is friction that breaks the protocol).
# BRRs contain no user data and are already on the stream branch — not shipped.
docs/analysis/blast_radius/
docs/missions/
docs/agentic_output/
docs/analysis/
