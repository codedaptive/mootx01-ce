  "uuid_mapping_cases": [
    {
      "id": "basic-mapping",
      "retrieved_uuids": ["uuid-1", "uuid-2", "uuid-3"],
      "manifest": [
        {"uuid": "uuid-1", "session_id": "sess_a"},
        {"uuid": "uuid-2", "session_id": "sess_b"},
        {"uuid": "uuid-3", "session_id": "sess_a"}
      ],
      "expected_ranked_session_ids": ["sess_a", "sess_b"],
      "note": "uuid-1 and uuid-3 both map to sess_a; only first occurrence establishes rank. sess_a rank 1 (uuid-1), sess_b rank 2 (uuid-2)"
    },
    {
      "id": "unknown-uuid-dropped",
      "retrieved_uuids": ["uuid-x", "uuid-1", "uuid-y"],
      "manifest": [
        {"uuid": "uuid-1", "session_id": "sess_a"}
      ],
      "expected_ranked_session_ids": ["sess_a"],
      "note": "uuid-x and uuid-y not in manifest → dropped. Only uuid-1 maps, giving sess_a at rank 1"
    },
    {
      "id": "all-same-session",
      "retrieved_uuids": ["uuid-1", "uuid-2", "uuid-3"],
      "manifest": [
        {"uuid": "uuid-1", "session_id": "sess_a"},
        {"uuid": "uuid-2", "session_id": "sess_a"},
        {"uuid": "uuid-3", "session_id": "sess_a"}
      ],
      "expected_ranked_session_ids": ["sess_a"],
      "note": "All UUIDs map to the same session → deduplicated to one entry"
    },
    {
      "id": "empty-retrieved",
      "retrieved_uuids": [],
      "manifest": [
        {"uuid": "uuid-1", "session_id": "sess_a"}
      ],
      "expected_ranked_session_ids": [],
      "note": "No UUIDs retrieved → empty session ranking"
    },
    {
      "id": "order-preserved",
      "retrieved_uuids": ["uuid-3", "uuid-1", "uuid-2"],
      "manifest": [
        {"uuid": "uuid-1", "session_id": "sess_b"},
        {"uuid": "uuid-2", "session_id": "sess_c"},
        {"uuid": "uuid-3", "session_id": "sess_a"}
      ],
      "expected_ranked_session_ids": ["sess_a", "sess_b", "sess_c"],
      "note": "Retrieval order determines session rank. uuid-3→sess_a comes first in retrieval, so sess_a is rank 1"
    }
  ]
