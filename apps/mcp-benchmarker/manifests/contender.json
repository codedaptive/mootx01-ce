{
  "schema_version": 1,
  "product": {
    "id": "contender",
    "displayName": "Contender endpoint",
    "version": "current",
    "homepage": "https://example.invalid",
    "provenance": "ground-truth-ours",
    "provenanceNote": "Worked example of a third-party MCP memory endpoint. ChromaDB-backed hybrid retrieval: per-hit results carry both a vector similarity/distance and a bm25_score, so the query path is vector_cosine + BM25. Tool surface verified against the live endpoint."
  },
  "transport": { "stdio": { "command": "contender-mcp" } },
  "role": "both",
  "calls": {
    "write": {
      "tool": "contender_add_drawer",
      "args": { "content": "content" },
      "constantArgs": { "wing": "benchmark", "room": "import" },
      "result": { "kind": "jsonObjects", "idKey": "drawer_id", "contentKey": "content" },
      "technique": ["embedding"]
    },
    "query": {
      "tool": "contender_search",
      "args": { "query": "query" },
      "constantArgs": {},
      "result": { "kind": "jsonObjects", "idKey": "drawer_id", "contentKey": "text" },
      "technique": ["bm25", "vector_cosine"]
    },
    "list": {
      "tool": "contender_list_drawers",
      "args": {},
      "constantArgs": {},
      "result": { "kind": "jsonObjects", "idKey": "drawer_id", "contentKey": "content_preview" },
      "technique": ["none"],
      "pagination": { "limitArg": "limit", "offsetArg": "offset", "pageSize": 100 }
    },
    "fetch": {
      "tool": "contender_get_drawer",
      "args": { "id": "drawer_id" },
      "constantArgs": {},
      "result": { "kind": "jsonObjects", "idKey": "drawer_id", "contentKey": "content", "fetchContentKey": "content" },
      "technique": ["none"]
    }
  }
}
