{
  "backendA": {
    "name": "mempalace",
    "command": "mempalace-mcp --palace __MP_DIR__",
    "verbMap": {
      "write": "mempalace_add_drawer",
      "query": "mempalace_search",
      "contentArg": "content",
      "queryArg": "query",
      "constantArgs": {
        "wing": "scratch",
        "room": "notes"
      },
      "resultFormat": {
        "kind": "jsonObjects",
        "contentKey": "text"
      }
    }
  },
  "backendB": {
    "name": "mootx01",
    "command": "mootx01 serve --db __MOOT_DIR__/bridge",
    "verbMap": {
      "write": "moot_file_memory",
      "query": "moot_memory_search",
      "contentArg": "content",
      "queryArg": "query",
      "subjectArg": "subject",
      "constantArgs": {
        "wing": "scratch",
        "location": "notes"
      },
      "resultFormat": {
        "kind": "mootText"
      }
    }
  },
  "primary": "mempalace"
}
