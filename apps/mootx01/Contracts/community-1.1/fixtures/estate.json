          },
          "receiptID": "20000000-0000-0000-0000-000000000002"
        }
      }
    },
    {
      "id": "estate-open-missing-key",
      "covers": ["refusal"],
      "method": "moot_community_estate_open",
      "arguments": {"estateID": "20000000-0000-0000-0000-000000000003"},
      "result": {
        "state": "missingKey",
        "estate": {
          "id": "20000000-0000-0000-0000-000000000003",
          "name": "Recovered estate",
          "schemaVersion": "1.0"
