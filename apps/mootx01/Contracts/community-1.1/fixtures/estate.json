      "covers": ["success"],
      "method": "moot_community_estate_inspect",
      "arguments": {},
      "result": {"state": "needsCreation"}
    },
    {
      "id": "estate-create-ready",
      "covers": ["success"],
      "method": "moot_community_estate_create",
      "arguments": {"name": "My MOOT"},
