  "f1_score_cases": [
    {
      "id": "identical",
      "prediction": "cat",
      "gold": "cat",
      "expected_f1": 1.0,
      "note": "Exact token match after normalise+stem"
    },
    {
      "id": "stem-match",
      "prediction": "cats",
      "gold": "cat",
      "expected_f1": 1.0,
      "note": "Both 'cats' and 'cat' stem to 'cat' → multiset intersection = 1 → F1=1.0"
    },
    {
      "id": "no-overlap",
      "prediction": "hello",
      "gold": "world",
      "expected_f1": 0.0,
      "note": "Disjoint token sets → num_same=0 → F1=0.0"
    },
    {
      "id": "partial-extra-token",
      "prediction": "hello world",
      "gold": "world",
      "expected_f1": 0.6666666666666666,
      "note": "intersection={world:1}, precision=1/2, recall=1/1, F1=2*(1/2)*1/(3/2)=2/3"
    },
    {
      "id": "stem-dogs-running",
      "prediction": "running dogs",
      "gold": "dog run",
      "expected_f1": 1.0,
      "note": "'running'→'run','dogs'→'dog'; both pairs match after stemming → F1=1.0"
    }
  ],

  "multi_answer_f1_cases": [
    {
      "id": "perfect",
      "prediction": "cat, dog",
      "gold": "cat, dog",
      "expected": 1.0,
      "note": "All gold parts maximally matched → mean=1.0"
    },
    {
      "id": "partial",
      "prediction": "cat, dog",
      "gold": "cat, feline",
      "expected": 0.5,
      "note": "gold 'cat': max(f1('cat','cat'),f1('dog','cat'))=1.0; gold 'feline': max=0.0; mean=0.5"
    },
    {
      "id": "no-match",
      "prediction": "apple",
      "gold": "cat, dog",
      "expected": 0.0,
      "note": "Neither gold part matches prediction → mean=0.0"
    }
  ],

  "exact_match_cases": [
    {
      "id": "article-stripped",
      "prediction": "the cat",
      "gold": "cat",
      "expected": 1.0,
      "note": "normalize('the cat')='cat' → set{'cat'} == set{'cat'} → 1.0"
    },
    {
      "id": "order-independent",
      "prediction": "cat sat",
      "gold": "sat cat",
      "expected": 1.0,
      "note": "Token sets are order-independent → equal → 1.0"
    },
    {
      "id": "different",
      "prediction": "hello",
      "gold": "world",
      "expected": 0.0,
      "note": "Different tokens → 0.0"
    }
  ],

