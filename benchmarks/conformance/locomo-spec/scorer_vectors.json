{
  "_comment": "Conformance vectors for LoCoMoSpecScorer (§1–§5 of LOCOMO_OFFICIAL_PROTOCOL.md). Both the Swift twin (LoCoMoSpecScorer.swift) and the Rust twin (locomo_spec_scorer.rs) must reproduce every expected value exactly (floating-point equality for values that are exact; tolerance 1e-9 for values computed via division). Vectors are chosen to avoid Python round()-vs-f64::round() half-boundary divergence. Porter expectations were generated and checked with nltk==3.9.2 PorterStemmer() in its default NLTK_EXTENSIONS mode; normalization and scoring follow the verbatim LoCoMo rules.",

  "normalize_answer_cases": [
    {
      "id": "empty",
      "input": "",
      "expected": "",
      "note": "Empty input → empty output"
    },
    {
      "id": "comma-punctuation-case",
      "input": "Hello, World!",
      "expected": "hello world",
      "note": "Comma stripped in step 1; '!' removed by punctuation step; lowercased"
    },
    {
      "id": "article-and",
      "input": "a dog and a cat",
      "expected": "dog cat",
      "note": "'a' and 'and' removed as whole words by article step"
    },
    {
      "id": "the-article",
      "input": "The quick brown fox",
      "expected": "quick brown fox",
      "note": "'the' removed as whole word (case-insensitive via lowercase step)"
    },
    {
      "id": "apostrophe",
      "input": "runner's high",
      "expected": "runners high",
      "note": "Apostrophe is in Python string.punctuation; removed leaving 'runners'"
    },
    {
      "id": "multi-comma",
      "input": "one, two, three",
      "expected": "one two three",
      "note": "All commas stripped in step 1 (before lowercase)"
    }
  ],

  "porter_stem_cases": [
    {
      "id": "empty",
      "input": "",
      "expected": "",
      "note": "Empty string returned unchanged"
    },
    {
      "id": "one-char",
      "input": "a",
      "expected": "a",
      "note": "Length ≤ 2: returned unchanged"
    },
    {
      "id": "two-char",
      "input": "in",
      "expected": "in",
      "note": "Length ≤ 2: returned unchanged"
    },
    {
      "id": "two-char-lowercase",
      "input": "IN",
      "expected": "in",
      "note": "NLTK lowercases before the short-word return"
    },
    {
      "id": "step1a-sses",
      "input": "caresses",
      "expected": "caress",
      "note": "Step 1a: SSES → SS (Porter 1980 paper example)"
    },
    {
      "id": "step1a-ies-ponies",
      "input": "ponies",
      "expected": "poni",
      "note": "Step 1a: IES → I (Porter 1980 paper example)"
    },
    {
      "id": "step1a-ies-ties",
      "input": "ties",
      "expected": "tie",
      "note": "NLTK extension: four-letter IES → IE"
    },
    {
      "id": "step1a-tie-control",
      "input": "tie",
      "expected": "tie",
      "note": "Control paired with ties: the uninflected word remains unchanged"
    },
    {
      "id": "step1a-ies-dies",
      "input": "dies",
      "expected": "die",
      "note": "NLTK extension: four-letter IES → IE"
    },
    {
      "id": "step1a-s",
      "input": "cats",
      "expected": "cat",
      "note": "Step 1a: S → '' (Porter 1980 paper example)"
    },
    {
      "id": "step1b-ing-double-nn",
      "input": "running",
      "expected": "run",
      "note": "Step 1b: (*v*) ING → '' then double-consonant -nn → -n (Porter 1980)"
    },
    {
      "id": "step1b-ing-double-mm",
      "input": "stemming",
      "expected": "stem",
      "note": "Step 1b: (*v*) ING → '' then double-consonant -mm → -m"
    },
    {
      "id": "step1b-ing-no-followup",
      "input": "jumping",
      "expected": "jump",
      "note": "Step 1b: (*v*) ING → '' — no double-consonant or *o follow-up needed"
    },
    {
      "id": "step1b-ed-double",
      "input": "stemmed",
      "expected": "stem",
      "note": "Step 1b: (*v*) ED → '' then double-consonant -mm → -m"
    },
    {
      "id": "step1b-ied-four-letter",
      "input": "died",
      "expected": "die",
      "note": "NLTK extension: four-letter IED → IE"
    },
    {
      "id": "step1b-ied-longer",
      "input": "spied",
      "expected": "spi",
      "note": "NLTK extension: longer IED → I"
    },
    {
      "id": "step1b-eed-no-fallthrough",
      "input": "feed",
      "expected": "feed",
      "note": "A failed EED measure does not fall through to the ED rule"
    },
    {
      "id": "step1b-two-letter-vc",
      "input": "uping",
      "expected": "upe",
      "note": "NLTK extension: a two-letter VC stem satisfies ends_cvc"
    },
    {
      "id": "step1c-y-consonant",
      "input": "fly",
      "expected": "fli",
      "note": "NLTK extension: consonant-preceded Y → I without a prior-vowel requirement"
    },
    {
      "id": "step1c-y-vowel",
      "input": "enjoy",
      "expected": "enjoy",
      "note": "NLTK extension: vowel-preceded Y remains Y"
    },
    {
      "id": "step2-recursive-alli",
      "input": "operationally",
      "expected": "oper",
      "note": "NLTK extension recursively re-applies Step 2 after ALLI → AL"
    },
    {
      "id": "step2-bli",
      "input": "possibly",
      "expected": "possibl",
      "note": "Martin/NLTK extension uses BLI → BLE rather than ABLI → ABLE"
    },
    {
      "id": "step2-fulli",
      "input": "hopefully",
      "expected": "hope",
      "note": "NLTK-only FULLI → FUL rule"
    },
    {
      "id": "step2-logi",
      "input": "geologi",
      "expected": "geolog",
      "note": "NLTK-only LOGI → LOG rule with the L included in the measure"
    },
    {
      "id": "irregular-skies",
      "input": "skies",
      "expected": "sky",
      "note": "NLTK irregular-form pool"
    },
    {
      "id": "irregular-skies-uppercase",
      "input": "SKIES",
      "expected": "ski",
      "note": "NLTK lowercases suffix processing but checks its exception pool against the original spelling"
    },
    {
      "id": "irregular-dying",
