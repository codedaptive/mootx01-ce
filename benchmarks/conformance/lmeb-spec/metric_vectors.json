  "rcap_macro_average_cases": [
    {
      "id": "rcap_macro_avg_ignores_none",
      "description": "Macro average ignores None: [None, 1.0] → avg=1.0 (§A3, metric.py round(val,5)).",
      "per_query_values": [null, 1.0],
      "expected_avg": 1.0
    },
    {
      "id": "rcap_macro_avg_all_none",
      "description": "All None → macro average = None (§A3).",
      "per_query_values": [null, null, null],
      "expected_avg": null
    },
    {
      "id": "rcap_macro_avg_mixed",
      "description": "Mixed [0.5, None, 1.0] → avg=round((0.5+1.0)/2, 5)=0.75.",
      "per_query_values": [0.5, null, 1.0],
      "expected_avg": 0.75
    },
    {
      "id": "rcap_macro_avg_rounding_5decimals",
      "description": "Values sum to non-terminating decimal: [1.0, 0.5, 0.0] → avg=0.5.",
      "per_query_values": [1.0, 0.5, 0.0],
      "expected_avg": 0.5
    }
  ],

  "skip_first_result_cases": [
    {
      "id": "skip_first_result_drops_rank1_relevant",
      "description": "Relevant at rank 1; after skip_first_result, rank 1 is dropped. nDCG@5=0, Recall@5=0.",
      "options": {"skip_first_result": true, "ignore_identical_ids": false},
      "query_id": "q1",
      "ranked_doc_ids": ["A", "B", "C", "D", "E"],
      "relevant_doc_ids": ["A"],
      "after_filter": ["B", "C", "D", "E"],
      "ndcg_at_5": 0.0,
      "recall_at_5": 0.0,
      "rcap_at_5": 0.0,
      "mrr_at_5": 0.0
    },
    {
      "id": "skip_first_result_irrelevant_head",
      "description": "skip_first_result=true; rank 1 is irrelevant (B), relevant A at rank 2 → rank 1 after skip. nDCG@5=1.0.",
      "options": {"skip_first_result": true, "ignore_identical_ids": false},
      "query_id": "q1",
      "ranked_doc_ids": ["B", "A", "C"],
      "relevant_doc_ids": ["A"],
      "after_filter": ["A", "C"],
      "ndcg_at_5": 1.0,
      "recall_at_5": 1.0,
      "rcap_at_5": 1.0,
      "mrr_at_5": 1.0
