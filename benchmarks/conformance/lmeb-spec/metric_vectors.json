  "ignore_identical_ids_cases": [
    {
      "id": "ignore_identical_ids_removes_self",
      "description": "Query ID = 'doc1'; doc1 is at rank 1 and removed. doc2 (relevant) becomes rank 1. nDCG@1=1.0.",
