      "k": 10,
      "ndcg": 0.9197207891481882
    },
    {
      "id": "ndcg_one_relevant_at_rank3_k5",
      "description": "Single relevant at rank 3, k=5. DCG=1/log2(4)=0.5, IDCG=1. nDCG=0.5.",
      "ranked_doc_ids": ["X", "Y", "A", "Z", "W"],
      "relevant_doc_ids": ["A"],
      "k": 5,
