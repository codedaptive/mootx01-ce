  "aggregation_cases": [
    {
      "id": "aggregation_two_level",
      "description": "Two-level aggregation: subset macro mean → task mean (§A1/§A3). nDCG@10 headline.",
      "subsets": [
        {
          "subset_name": "user_evidence",
          "queries": [
            {
              "query_id": "q1",
              "ranked_doc_ids": ["A"],
              "relevant_doc_ids": ["A"]
            },
            {
              "query_id": "q2",
              "ranked_doc_ids": ["X", "Y", "A", "Z"],
              "relevant_doc_ids": ["A"]
            }
          ],
          "expected_ndcg_at_10": 0.75
        },
        {
          "subset_name": "preference_evidence",
          "queries": [
            {
              "query_id": "q3",
              "ranked_doc_ids": ["X", "Y", "Z"],
              "relevant_doc_ids": ["A"]
            }
          ],
          "expected_ndcg_at_10": 0.0
        }
      ],
      "expected_task_ndcg_at_10": 0.375
    },
    {
      "id": "aggregation_rcap_none_propagation",
      "description": "R_cap None propagation through both aggregation levels (§A3).",
      "subsets": [
        {
          "subset_name": "user_evidence",
          "queries": [
            {
              "query_id": "q_no_relevant",
              "ranked_doc_ids": ["A", "B"],
              "relevant_doc_ids": []
            },
            {
              "query_id": "q_with_relevant",
              "ranked_doc_ids": ["A", "B"],
              "relevant_doc_ids": ["A"]
            }
          ],
          "expected_rcap_at_5": 1.0,
          "note": "None ignored in macro avg; only q_with_relevant contributes: 1/min(1,5)=1.0"
        },
        {
          "subset_name": "preference_evidence",
          "queries": [
            {
              "query_id": "q_all_none",
              "ranked_doc_ids": ["A", "B"],
              "relevant_doc_ids": []
            }
          ],
          "expected_rcap_at_5": null,
          "note": "All queries have None → subset R_cap@5 = None"
        }
      ],
      "expected_task_rcap_at_5": 1.0,
      "task_note": "One subset None, one subset 1.0 → task mean = 1.0"
    }
  ],

  "instruction_cases": [
