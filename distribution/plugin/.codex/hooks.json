{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook SessionStart",
            "timeout": 3,
            "statusMessage": "MOOTx01 session orientation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook UserPromptSubmit",
            "timeout": 3,
            "statusMessage": "MOOTx01 bounded recall"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__mootx01__.*|moot_.*",
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook PreCompact",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook PostCompact",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook Stop",
            "timeout": 2,
            "statusMessage": "MOOTx01 writeback gate"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "mootx01 codex-hook SessionEnd",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
