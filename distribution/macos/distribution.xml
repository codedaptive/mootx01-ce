<?xml version="1.0" encoding="utf-8"?>
<!--
  distribution.xml — macOS .pkg installer layout for MOOTx01.

  Controls the Installer.app UI: welcome → license → install → conclusion.
  The payload installs into the user's home (~/.mootx01/) via a component
  package built by pkgbuild; this distribution wrapper adds the branded
  panels.

  Built by: productbuild - -distribution distribution.xml - -package-path ./pkgs mootx01.pkg
  Signed by: productsign - -sign "Developer ID Installer: Codedaptive, LLC (G94X5T5GK7)"
-->
<installer-gui-script minSpecVersion="2" hostArchitectures="arm64">
    <title>MOOTx01</title>
    <organization>com.codedaptive</organization>

    <!-- Welcome, license, and conclusion panels -->
    <welcome    file="welcome.html"    mime-type="text/html" />
    <license    file="license.html"    mime-type="text/html" />
    <conclusion file="conclusion.html" mime-type="text/html" />

    <!-- System requirements -->
    <os-version min="15.0" />

    <!-- Single choice: the mootx01 component package -->
    <choices-outline>
        <line choice="com.codedaptive.mootx01.pkg" />
    </choices-outline>

    <choice id="com.codedaptive.mootx01.pkg"
            title="MOOTx01"
            description="MOOTx01 memory server, management console, and setup assistant."
            visible="true"
            enabled="true">
        <pkg-ref id="com.codedaptive.mootx01.pkg" />
    </choice>

    <pkg-ref id="com.codedaptive.mootx01.pkg"
             version="0"
             installKBytes="0"
             auth="root">mootx01-component.pkg</pkg-ref>
</installer-gui-script>
