#!/bin/bash
# postinstall — runs after the macOS .pkg places files.
#
# The .pkg installs the payload into a root-owned staging area at
# /Library/Application Support/com.codedaptive.mootx01/staging.
# /Library/Application Support is owned by root:wheel and is NOT
# world-writable, so a local attacker cannot pre-create or race-modify
# the staging directory. This script validates the staging area before
# trusting any content: it rejects symlinks, non-root ownership, and
# group/other-writable permissions. Only after those checks pass does
# it copy, symlink, chown, and launch the staged binaries.
#
# This script:
#   1. Validates the staging directory (ownership, not-a-symlink, permissions, realpath).
#   2. Validates each staged file (not-a-symlink) before ditto.
#   3. Moves the staged files to ~/.mootx01/ in the installing user's home.
#   4. Creates ~/.local/bin symlinks (same layout as install.sh).
#   5. Launches the setup assistant for interactive client wiring.
#
# IMPORTANT: this script must NEVER return non-zero. A postinstall
# failure causes the macOS Installer to roll back ALL file placement,
# which is worse than any individual step failing here. Every command
# is guarded; exit 0 is unconditional. Validation failures abort the
# file-placement block but do not prevent the exit 0.

# The staging area that pkgbuild placed the payload into.
# /Library/Application Support is owned by root:wheel (mode 755),
# so only root can create/modify content here — the world-writable
# /tmp attack surface is eliminated.
STAGING="/Library/Application Support/com.codedaptive.mootx01/staging"
INSTALL_DIR="$HOME/.mootx01"
LOCAL_BIN="$HOME/.local/bin"

# ── Staging directory validation ─────────────────────────────────────────────
# All checks run before ANY content is trusted. Any failure aborts the
# file-placement block and skips ditto/chown/launch. exit 0 is still
# unconditional (see IMPORTANT note above).

STAGING_OK=0  # 0 = checks passed, 1 = failed

if [ -d "$STAGING" ]; then
    # Reject if STAGING itself is a symlink — a symlink could redirect to
    # an attacker-controlled directory even when the parent is root-owned.
    if [ -L "$STAGING" ]; then
        echo "postinstall: SECURITY: staging path is a symlink — aborting file placement" >&2
        STAGING_OK=1
    fi

    # Verify that STAGING is owned by root (uid 0). The pkg places the dir
    # as root during installation; if it is owned by any other user, something
    # has gone wrong and we must not trust the content.
    if [ "$STAGING_OK" -eq 0 ]; then
        STAGING_UID="$(stat -f '%u' "$STAGING" 2>/dev/null)"
        if [ "$STAGING_UID" != "0" ]; then
            echo "postinstall: SECURITY: staging dir not owned by root (uid=$STAGING_UID) — aborting" >&2
            STAGING_OK=1
        fi
    fi

    # Verify that STAGING is not group-writable or other-writable.
    # Mode bits: stat -f '%Mp%Lp' on macOS returns 4-octal-digit permission string.
    if [ "$STAGING_OK" -eq 0 ]; then
        STAGING_MODE="$(stat -f '%Mp%Lp' "$STAGING" 2>/dev/null)"
        # Extract the group and other write bits from the mode string.
        # stat -f '%Mp%Lp' returns e.g. "0755"; we need positions 2 and 3 (0-indexed).
        # A group-write bit means the group octet has bit 2 set (value 2 in the octet).
        # An other-write bit means the other octet has bit 2 set.
        GROUP_OCTET="${STAGING_MODE:2:1}"
        OTHER_OCTET="${STAGING_MODE:3:1}"
        # Group octet: writable if octet is 2,3,6,7 (bit 2 of 0-7 set).
        # Other octet: same logic.
        if echo "$GROUP_OCTET" | grep -qE '^[2367]$' || echo "$OTHER_OCTET" | grep -qE '^[2367]$'; then
            echo "postinstall: SECURITY: staging dir is group/other-writable (mode=$STAGING_MODE) — aborting" >&2
            STAGING_OK=1
        fi
    fi

    # Verify that the canonical (symlink-resolved) path of STAGING is the
    # expected path. This guards against any path-component symlink that
    # redirects elsewhere even when STAGING itself passed the -L check above.
    # Resolved with a shell-native `cd … && pwd -P` (subshell) rather than
    # python3: a stock end-user Mac has no python3 until the Command Line Tools
    # are installed, and a missing interpreter here would make every install
    # silently no-op. `pwd -P` resolves all symlinks in the path using only the
    # shell. `cd` into a root-owned, non-writable dir is safe for root.
    if [ "$STAGING_OK" -eq 0 ]; then
        CANONICAL_STAGING="/Library/Application Support/com.codedaptive.mootx01/staging"
        REAL_STAGING="$(cd "$STAGING" 2>/dev/null && pwd -P)"
        if [ "$REAL_STAGING" != "$CANONICAL_STAGING" ]; then
            echo "postinstall: SECURITY: staging realpath '$REAL_STAGING' != expected '$CANONICAL_STAGING' — aborting" >&2
            STAGING_OK=1
        fi
    fi
else
    # Staging dir does not exist — nothing to install (unexpected, but not fatal).
    STAGING_OK=1
fi

# ── File placement (only if all staging checks passed) ───────────────────────

if [ "$STAGING_OK" -eq 0 ]; then
    mkdir -p "$INSTALL_DIR" 2>/dev/null

    # Validate each source before ditto: must not be a symlink.
    # If either source is a symlink, skip placement for that item.
    BIN_SRC="$STAGING/bin"
    APP_SRC="$STAGING/Mootx01Setup.app"

    if [ -L "$BIN_SRC" ]; then
        echo "postinstall: SECURITY: staged bin/ is a symlink — skipping bin placement" >&2
    elif [ -d "$BIN_SRC" ]; then
        # Use ditto for reliable recursive merge (handles .app bundles, xattrs).
        ditto "$BIN_SRC" "$INSTALL_DIR/bin" 2>/dev/null
    fi

    if [ -L "$APP_SRC" ]; then
        echo "postinstall: SECURITY: staged Mootx01Setup.app is a symlink — skipping app placement" >&2
    elif [ -d "$APP_SRC" ]; then
        ditto "$APP_SRC" "$INSTALL_DIR/Mootx01Setup.app" 2>/dev/null
    fi

    # Clean up the staging area now that content has been copied out.
    rm -rf "$STAGING" 2>/dev/null
fi

# ── Symlinks onto PATH ────────────────────────────────────────────────────────
mkdir -p "$LOCAL_BIN" 2>/dev/null
ln -sf "$INSTALL_DIR/bin/mootx01"  "$LOCAL_BIN/mootx01"  2>/dev/null
ln -sf "$INSTALL_DIR/bin/moot-mgr" "$LOCAL_BIN/moot-mgr" 2>/dev/null

# ── Fix ownership ─────────────────────────────────────────────────────────────
# pkgbuild runs postinstall as root, but these are user-owned files.
# Prefer the console user from /dev/console (not attacker-influenceable $USER).
# Fall back to $SUDO_USER then $USER if /dev/console is unavailable.
REAL_USER="$(stat -f '%Su' /dev/console 2>/dev/null)"
if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
    REAL_USER="${SUDO_USER:-${USER:-}}"
fi
if [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
    chown -R "$REAL_USER" "$INSTALL_DIR" 2>/dev/null
    # The PATH directory and its parent, NOT just the symlinks inside it.
    # `mkdir -p "$LOCAL_BIN"` above runs as root, so any component it had to
    # create — commonly both ~/.local and ~/.local/bin on a fresh Mac — is left
    # root-owned. Chowning only the symlinks (as this did until 2026-08-05) still
    # leaves the user unable to REPLACE them, because unlink needs write on the
    # containing directory. `mootx01 install` then dies with
    # NSCocoaErrorDomain 513 / EPERM 13 "couldn't be removed because you don't
    # have permission", and the follow-up setup never runs: no server, no
    # database. Reported from a clean 1.0.38 install on 2026-08-05.
    #
    # Deliberately NOT recursive: ~/.local is shared with pipx, cargo, codegraph
    # and others, and re-owning their files would be a far worse bug than the one
    # being fixed. Only the two directories themselves.
    chown "$REAL_USER" "$HOME/.local" "$LOCAL_BIN" 2>/dev/null
    chown -h "$REAL_USER" "$LOCAL_BIN/mootx01" 2>/dev/null
    chown -h "$REAL_USER" "$LOCAL_BIN/moot-mgr" 2>/dev/null
fi

# ── Restart resident services (upgrade path) ─────────────────────────────────
# The .pkg replaces the binaries on disk, but an already-running resident
# daemon and management console keep executing the OLD image until they are
# restarted — an upgrade otherwise looks like it "didn't take" (stale
# dashboard, stale daemon) until reboot. `kickstart -k` kills and restarts a
# job only if it is loaded, so on a fresh install (nothing loaded yet) both
# calls are silent no-ops. Daemon first, console second, matching
# LaunchAgent.restart() so the console reconnects to the fresh daemon.
# Labels mirror MootPaths.daemonLabel / MootPaths.launchAgentLabel in
# apps/mootx01/Sources/MootInstallerCore/Paths.swift — keep in sync.
# Best-effort: never fails the install.
if [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
    REAL_UID="$(id -u "$REAL_USER" 2>/dev/null)"
    if [ -n "$REAL_UID" ]; then
        launchctl kickstart -k "gui/$REAL_UID/com.mootx01.daemon" 2>/dev/null
        launchctl kickstart -k "gui/$REAL_UID/com.mootx01.mgr"    2>/dev/null
    fi
fi

# ── Launch setup assistant ────────────────────────────────────────────────────
# Best-effort. If this fails for any reason the user can always run
# `mootx01 install` from a terminal.
SETUP_APP="$INSTALL_DIR/Mootx01Setup.app"
if [ -d "$SETUP_APP" ] && [ ! -L "$SETUP_APP" ] && [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
    sudo -u "$REAL_USER" open "$SETUP_APP" 2>/dev/null &
fi

exit 0
