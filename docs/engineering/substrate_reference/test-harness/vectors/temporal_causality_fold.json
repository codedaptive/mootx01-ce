            "hlc": { "physicalTime": 60000, "logicalCount": 0, "nodeID": 0 },
            "fieldCoords": [{ "fieldPath": "field-b", "valueRepr": "bitmap:20" }]
          }
        ],
        "windowMinutes": 256,
        "startWatermark": { "physicalTime": 0, "logicalCount": 0, "nodeID": 0 }
