      "description": "Empty entry list: no deltas, watermark unchanged at zero",
      "input": {
        "entries": [],
        "windowMinutes": 256,
        "startWatermark": { "physicalTime": 0, "logicalCount": 0, "nodeID": 0 }
      },
      "expected": {
        "deltas": [],
        "newWatermark": { "physicalTime": 0, "logicalCount": 0, "nodeID": 0 }
      }
    },
    {
      "id": "tcf-002",
      "description": "Single entry: no pairs (nothing to pair against), watermark advances",
